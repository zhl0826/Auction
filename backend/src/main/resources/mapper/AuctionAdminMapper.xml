<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.AuctionAdminMapper">
    <resultMap id="map" type="com.example.entity.AuctionAdmin">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="list" resultMap="map">
        SELECT * FROM auction_admin
        <where>
            <if test="keyword != null and keyword != ''">
                AND (username LIKE CONCAT('%', #{keyword}, '%') OR nickname LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <insert id="insert" parameterType="com.example.entity.AuctionAdmin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO auction_admin(username, password, nickname, status, created_at)
        VALUES(#{username}, #{password}, #{nickname}, #{status}, NOW())
    </insert>

    <update id="updateStatus">
        UPDATE auction_admin SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM auction_admin WHERE id = #{id}
    </delete>

    <select id="findByUsername" resultMap="map">
        SELECT * FROM auction_admin WHERE username = #{username} LIMIT 1
    </select>
</mapper>
