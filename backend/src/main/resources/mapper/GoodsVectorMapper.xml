<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.GoodsVectorMapper">
    <resultMap id="map" type="com.example.entity.GoodsVector">
        <id property="goodsId" column="goods_id"/>
        <result property="embedding" column="embedding"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <insert id="insert">
        INSERT INTO goods_vector(goods_id, embedding, updated_at)
        VALUES (#{goodsId}, #{embedding}, NOW())
    </insert>
    <update id="update">
        UPDATE goods_vector SET embedding = #{embedding}, updated_at = NOW()
        WHERE goods_id = #{goodsId}
    </update>
    <select id="findByGoodsId" resultMap="map">
        SELECT * FROM goods_vector WHERE goods_id = #{goodsId}
    </select>
    <select id="findAll" resultMap="map">
        SELECT * FROM goods_vector
    </select>
    <delete id="deleteByGoodsId">
        DELETE FROM goods_vector WHERE goods_id = #{goodsId}
    </delete>
</mapper>